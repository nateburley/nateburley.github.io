---
// The file-tree sidebar: photo, name, availability, nav, and social icons.
// `active` highlights the matching NAV item (by its `key`).
import { NAV, SOCIAL } from '../consts';

interface Props {
  active?: string;
}
const { active } = Astro.props;
---

<aside class="ladder" aria-label="Site navigation">
  <a href="/" style="border:none;">
    <img class="headshot" src="/images/nate_headshot.jpeg" alt="Nate Burley" width="104" height="104" />
  </a>
  <div class="who">
    <div class="name"><a href="/">Nate Burley</a></div>
    <div class="role">Machine Learning Engineer<br />Data Scientist · Robot Enthusiast</div>
  </div>
  <div class="avail"><span class="led"></span>available for work</div>

  <span class="root">~/nateburley</span>
  <ul class="navlist" id="nav">
    {
      NAV.map((item, i) => (
        <li data-key={item.key} class={active === item.key ? 'active' : ''}>
          <span class="tree">{i === NAV.length - 1 ? '└──' : '├──'}</span>
          <a href={item.href}>{item.label}</a>
          {active === item.key && <span class="marker">◀</span>}
        </li>
      ))
    }
  </ul>

  <div class="social">
    <a href={SOCIAL.linkedin} aria-label="LinkedIn" title="LinkedIn">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.3c0-1.26-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9z"/></svg>
    </a>
    <a href={SOCIAL.github} aria-label="GitHub" title="GitHub">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.9c-2.78.62-3.37-1.22-3.37-1.22-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.3 9.3 0 015 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.59.69.49A10.02 10.02 0 0022 12.25C22 6.58 17.52 2 12 2z"/></svg>
    </a>
    <a href={SOCIAL.twitter} aria-label="Twitter / X" title="Twitter / X">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.66l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.01 4.12H5.04z"/></svg>
    </a>
    <a href={SOCIAL.email} aria-label="Email" title="Email">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3.5 6.5L12 13l8.5-6.5"/></svg>
    </a>
  </div>
  <div class="meta">v2.0 · built with Astro</div>
</aside>
